<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ hồ sơ – được nhúng vào màn hình bằng thẻ <include> -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_lg"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <TextView
            style="@style/ProfileNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/student_name" />

        <TextView
            style="@style/MutedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/student_id_line" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/space_md"
            android:layout_marginBottom="@dimen/space_md"
            android:background="@color/divider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="12dp"
            android:gravity="center_vertical"
            android:text="@string/class_line"
            app:drawableStartCompat="@android:drawable/ic_menu_agenda" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:drawablePadding="12dp"
            android:gravity="center_vertical"
            android:text="@string/email_line"
            app:drawableStartCompat="@android:drawable/ic_dialog_email" />

        <!-- Hai ô thống kê chia đôi chiều ngang bằng layout_weight -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_stat"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    style="@style/StatValueText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_labs_value" />

                <TextView
                    style="@style/StatLabelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_labs_label" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:background="@drawable/bg_stat"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    style="@style/StatValueText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_score_value" />

                <TextView
                    style="@style/StatLabelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_score_label" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
